# Copy to `.env` and fill in real values. `.gitignore` ignores `.env*`, so
# `.env` itself never gets committed.

# Atlas CMS — live BE Care 24. Server-side only; never prefix these NEXT_PUBLIC_.

# Base URL BE (tanpa trailing slash). SDK menambahkan /api/v1/public sendiri.
ATLAS_BASE_URL=

# Delivery key (atlas_live_) — dibaca marketing-web saat render. Read-only,
# hanya melihat konten yang sudah published.
ATLAS_API_KEY=

# Management key (atlas_mgmt_) — HANYA untuk script seeding/migrasi yang
# dijalankan manual. Jangan pernah di-import dari kode runtime app.
# Scope: content:write, content:publish, media:write, schema:write
ATLAS_MGMT_KEY=

# Canonical site origin (tanpa trailing slash). Menyetir metadataBase,
# sitemap.ts, robots.ts, canonical URL, Organization.url, dan og:url.
# WAJIB diset di setiap environment deploy (production build) — kalau
# tidak, `next build` akan gagal dengan sengaja (lihat constants/site.ts).
#
# SENGAJA DIKOSONGKAN di sini: domain produksi belum diputuskan user. Kalau
# baris ini diisi (misalnya nilai lama `https://care24jpn.vercel.app`),
# `cp .env.example .env` diam-diam mengalahkan gerbang wajib-set di atas —
# build lokal/staging akan lolos dengan domain yang belum tentu benar tanpa
# siapa pun sadar sudah memutuskan sesuatu. Isi manual per environment saat
# domain sudah final.
NEXT_PUBLIC_SITE_URL=
